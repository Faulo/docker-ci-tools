<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>ci-tools</id>
    <version>1.0.0</version>
    <title>Faulo CI Tools</title>
    <authors>Daniel Schulz</authors>
    <description>Runtime dependencies for Faulo CI tools.</description>
    <dependencies>
      <dependency id="butler" />
      <dependency id="nodejs" />
      <dependency id="powershell-core" />
      <dependency id="php" version="[8.4,8.5)" />
      <dependency id="composer" />
    </dependencies>
  </metadata>
</package>
